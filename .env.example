# Copia este archivo a .env.local y coloca tu clave real de Gemini.
# La app funciona sin esta clave; solo las funciones de IA quedan deshabilitadas.
#
# ADVERTENCIA: esta es una app 100% de cliente. En un build publicado esta clave
# queda expuesta en el bundle. Para producción, custódiala detrás de un backend/proxy.
GEMINI_API_KEY=
